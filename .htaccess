RewriteEngine On

# Deny access to sensitive files
<FilesMatch "^(\.env|\.git|.*\.sql|.*\.log|composer\.(json|lock|phar)|package\.json|package-lock\.json|yarn\.lock|webpack\.config\.*|vite\.config\.*|tsconfig\.*|\.editorconfig|\.prettierrc|\.browserslistrc)$">
  Require all denied
</FilesMatch>

# Deny access to hidden files and directories
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\." - [F]
</IfModule>

# SEO 301 Redirects (from direct query URLs to clean URLs)
<IfModule mod_rewrite.c>
  RewriteCond %{THE_REQUEST} \s/+category\.php\?slug=([a-zA-Z0-9_-]+)\s [NC]
  RewriteRule ^category\.php$ /category/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+blog\.php\?slug=([a-zA-Z0-9_-]+)\s [NC]
  RewriteRule ^blog\.php$ /blog/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+blogs\.php\?category=([a-zA-Z0-9_-]+)\s [NC]
  RewriteRule ^blogs\.php$ /blog/category/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+blogs\.php(?:\s|\?) [NC]
  RewriteRule ^blogs\.php$ /blog? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+page\.php\?slug=([a-zA-Z0-9_-]+)\s [NC]
  RewriteRule ^page\.php$ /page/%1? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+contact\.php(?:\s|\?) [NC]
  RewriteRule ^contact\.php$ /contact? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+offers\.php(?:\s|\?) [NC]
  RewriteRule ^offers\.php$ /offers? [R=301,L]

  # Clean URLs Routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
  RewriteRule ^blog/category/([a-zA-Z0-9_-]+)/?$ blogs.php?category=$1 [L,QSA]
  RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog.php?slug=$1 [L,QSA]
  RewriteRule ^page/([a-zA-Z0-9_-]+)/?$ page.php?slug=$1 [L,QSA]
  RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category.php?slug=$1 [L,QSA]
  RewriteRule ^blog/?$ blogs.php [L,QSA]
  RewriteRule ^contact/?$ contact.php [L,QSA]
  RewriteRule ^offers/?$ offers.php [L,QSA]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.php

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
